{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chip-chop:schema:flow",
  "title": "chip-chop flow",
  "description": "A user journey: an ordered list of steps that moves through states. One file per flow, at <app>/.chipchop/flows/<id>.flow.yaml. Written to be read by humans and generated by AI.",
  "type": "object",
  "required": ["id", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "mocks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mock ids active for the whole flow."
    },
    "viewports": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "name": { "type": "string" },
        "text": { "type": "string" },
        "testId": { "type": "string" },
        "selector": { "type": "string" }
      }
    },
    "step": {
      "description": "Exactly one action per step.",
      "oneOf": [
        {
          "type": "object",
          "required": ["goto"],
          "additionalProperties": false,
          "properties": {
            "goto": { "type": "string", "pattern": "^/", "description": "Route to open." },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["click"],
          "additionalProperties": false,
          "properties": { "click": { "$ref": "#/$defs/target" }, "note": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["fill"],
          "additionalProperties": false,
          "properties": {
            "fill": {
              "type": "object",
              "required": ["target", "value"],
              "additionalProperties": false,
              "properties": {
                "target": { "$ref": "#/$defs/target" },
                "value": { "type": "string" }
              }
            },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["select"],
          "additionalProperties": false,
          "properties": {
            "select": {
              "type": "object",
              "required": ["target", "option"],
              "additionalProperties": false,
              "properties": {
                "target": { "$ref": "#/$defs/target" },
                "option": { "type": "string" }
              }
            },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["press"],
          "additionalProperties": false,
          "properties": { "press": { "type": "string", "description": "Key, e.g. Enter or Escape." }, "note": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["wait"],
          "additionalProperties": false,
          "properties": {
            "wait": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "visible": { "$ref": "#/$defs/target" },
                "hidden": { "$ref": "#/$defs/target" },
                "networkIdleMs": { "type": "integer", "minimum": 0 }
              }
            },
            "note": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["capture"],
          "additionalProperties": false,
          "properties": {
            "capture": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "Id of a state declared in states.yaml. Takes the screenshot, ARIA snapshot and network log for it."
            },
            "note": { "type": "string" }
          }
        }
      ]
    }
  }
}
