{
  "name": "chip-chop",
  "version": "0.4.2",
  "description": "Capture every UI state of a web app on two git refs and compare them: pixels, accessibility tree, requests and flow graph.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chip-chop": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-assets": "node ../../scripts/sync-assets.mjs",
    "build": "npm run sync-assets && tsc -p tsconfig.json",
    "typecheck": "npm run sync-assets && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-timeout=600000 \"dist/**/*.e2e.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "ajv": "^8.17.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.50.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
